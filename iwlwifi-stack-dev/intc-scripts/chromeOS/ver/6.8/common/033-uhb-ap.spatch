@@
identifier reg_rule_flags;
@@
iwl_parse_nvm_mcc_info(...)
{
...
	for (ch_idx = 0; ch_idx < num_of_ch; ch_idx++) {
+		struct ieee80211_channel *chan = &nvm_data->channels[ch_idx];
		band = iwl_nl80211_band_from_channel_idx(ch_idx);
...
		reg_rule_flags = iwl_nvm_get_regdom_bw_flags(...);
+
+		if (band == NL80211_BAND_6GHZ) {
+			chan->flags |= IEEE80211_CHAN_NO_6GHZ_VLP_CLIENT |
+				       IEEE80211_CHAN_NO_6GHZ_AFC_CLIENT;
+			if (ch_flags & NVM_CHANNEL_AFC)
+				chan->flags &= ~IEEE80211_CHAN_NO_6GHZ_AFC_CLIENT;
+			if (ch_flags & NVM_CHANNEL_VLP)
+				chan->flags &= ~IEEE80211_CHAN_NO_6GHZ_VLP_CLIENT;
+		}
...
		reg_query_regdb_wmm(regd->alpha2, center_freq, rule);
	}
...
}

@@
identifier cbss;
@@
ieee80211_bss_info_update(...)
{
...
	rcu_read_unlock();
+
+	if (!ieee80211_uhb_power_type_valid(mgmt, len, channel))
+		cbss = NULL;
+	else
		cbss = cfg80211_inform_bss_frame_data(...);
...
}

