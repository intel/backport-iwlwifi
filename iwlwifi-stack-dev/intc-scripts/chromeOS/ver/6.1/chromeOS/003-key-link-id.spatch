@add_key@
identifier ops;
identifier fn;
@@
struct cfg80211_ops ops = {
...,
	.add_key = fn,
...
};

@@
identifier add_key.fn;
identifier link_id;
@@
 int fn(...,
-	int link_id,
 	...)
{
+	int link_id = -1;
...
}

