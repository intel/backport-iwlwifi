@@
identifier link_id, resp, assoc_data;
@@
ieee80211_rx_mgmt_assoc_resp(...)
{
+#if LINUX_VERSION_IS_GEQ(6,0,0) && LINUX_VERSION_IS_LESS(6,5,7)
+	u8 link_addrs[IEEE80211_MLD_MAX_NUM_LINKS][ETH_ALEN];
