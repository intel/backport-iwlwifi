@change_to_rtnl@
identifier fn =~ "ieee80211_set_ringparam|ieee80211_get_ringparam|ieee80211_dfs_radar_detected_work|format_devstat_counter|ieee80211_if_read_sdata|ieee80211_if_write_sdata|ieee80211_if_read_link|ieee80211_if_write_link|sta_agg_status_write|aql_txq_limit_write";
@@
