{
<+...
(
-sdata->vif.cfg.s1g = E;
|
-if (E) F = params->beacon_rate;
|
-sdata->beacon_rate_set = false;
-if (wiphy_ext_feature_isset(local->hw.wiphy, NL80211_EXT_FEATURE_BEACON_RATE_LEGACY)) { ... }
|
-err = ieee80211_set_fils_discovery(...);
-if (err < 0) goto error;
|
-err = ieee80211_set_unsol_bcast_probe_resp(...);
-if (err < 0) goto error;
)
...+>
}

