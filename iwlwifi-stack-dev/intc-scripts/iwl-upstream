class DateProgressBar:
    def __init__(self, start):
        self.start = start
        self.now = datetime.now()
        def show_day(d):
            if d is None:
                return None
            return d.strftime('>>> %Y-%m-%d')
        self.length = (self.now - self.start).days or 1
        self.bar = click.progressbar(length=self.length,
                                     item_show_func=show_day)
        self.pos = 0

    def finish(self):
        self.bar.update(self.length - self.pos)

    def set_pos(self, dpos):
        pos = (dpos - self.start).days
        if pos > self.pos:
            self.bar.update(pos - self.pos, current_item=dpos)
            self.pos = pos

    def __enter__(self):
        self.bar.__enter__()
        return self

    def __exit__(self, type, value, tb):
        self.bar.__exit__(type, value, tb)

def _zero_iter(infile, sep=b'\x00'):
   partial = b''
   while True:
       data = infile.read(8192)
       if not data:
           break
       partial += data
       lines = partial.split(sep)
       partial = lines.pop()
       for line in lines:
           yield line
   if partial:
       yield partial

def _accepted_state(state):
    if not state:
        return False
    if state.startswith('applied:') or state.startswith('upstream:'):
        return True
    if state in ('upstream', 'patchwork:accepted', 'patchwork:mainlined'):
        return True
    return False


def _check_config(config, *keys):
    errors = []
    for k in keys:
        val = getattr(config, k)
        if isinstance(val, Missing):
            errors.append(f'{k}: {val.help}')
    if errors:
        raise click.UsageError('\n'.join(errors))

class Context:
    pass

def _init_db(db):
    db.execute('CREATE TABLE IF NOT EXISTS last_updated (key UNIQUE, value)')

def _get_last_updated(db, k, default=None):
    cur = db.cursor()
    res = db.execute('SELECT value FROM last_updated WHERE key=?', (k, ))
    fetch = res.fetchone()
    if fetch is None:
        return default
    return fetch[0]

# note: need to commit after this, with your changes
def _set_last_updated(db, k, val):
    cur = db.cursor()
    cur.execute('INSERT OR REPLACE INTO last_updated (key, value) VALUES (?, ?)', (k, val))

@click.group()
@click.pass_context
def iwl(ctx):
    '''
    Determine, show and manage upstreaming state of patches.
    '''
    ctx.obj = Context()
    # put that into the context, maybe we'll support a
    # --cache option later
    cache_dir = os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache'))
    iwl_cache = os.path.join(cache_dir, 'iwl-upstream')
    os.makedirs(iwl_cache, exist_ok=True)
    ctx.obj.db = sqlite3.connect(os.path.join(iwl_cache, 'cache.db'))
    _init_db(ctx.obj.db)

    config_dir = os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config'))
    ctx.obj.config = Config()
    try:
        with open(os.path.join(config_dir, 'iwl-upstream.yaml'), 'r') as cfg_file:
            loaded = yaml.safe_load(cfg_file)
        if loaded is not None:
            for k, v in loaded.items():
                if hasattr(ctx.obj.config, k):
                    setattr(ctx.obj.config, k, v)
    except FileNotFoundError:
        pass
    if len(ctx.obj.config.csv_format.split(',')) != len(ctx.obj.config.csv_format_header.split(',')):
        raise click.ClickException("Configuration items 'csv_format' and 'csv_format_header' mismatched!")

class LoreSearchParser(HTMLParser):
    def __init__(self, change_id_callback):
        super().__init__()
        self.next_url = None
        self.change_id_callback = change_id_callback
        self._a_info = None
        self._is_rfc = None

    def handle_starttag(self, tag, attrs):
        if tag != 'a':
            return
        self.in_a = True
        href = None
        is_next = False
        for k, v in attrs:
            if k == 'rel' and v == 'next':
                if href is not None:
                    self.next_url = href
                    return
                is_next = True
            if k == 'href':
                href = v
                if is_next:
                    self.next_url = href
                    return
            if k == 'href' and '@changeid' in v and '.' in v:
                change_id = v.split('.')[-1]
                change_id, _ = change_id.split('@')
                if change_id[0] == 'I' and len(change_id) == 41:
                    msgid = v
                    if msgid.endswith('/'):
                        msgid = v[:-1]
                    self._a_info = (change_id, msgid)

    def handle_data(self, data):
        if self._a_info is None:
            return
        self._is_rfc = data.startswith('[RFC') or data.startswith('[PATCH RFC')

    def handle_endtag(self, tag):
        if tag != 'a' or self._a_info is None:
            return
        assert self._is_rfc is not None
        self.change_id_callback(self._a_info[0], self._a_info[1], self._is_rfc)
        self._a_info = None
        self._is_rfc = None


def _refresh_lore(ctx):
    ctx.db.execute('CREATE TABLE IF NOT EXISTS lore (change_id, message_id UNIQUE, rfc)')
    cur = ctx.db.cursor()

    def found_change_id(change_id, message_id, rfc):
        cur.execute('INSERT OR IGNORE INTO lore (change_id, message_id, rfc) VALUES (?, ?, ?)', (change_id, message_id, rfc))

    from_str = ' OR '.join(f'f:{f}' for f in ctx.config.search_from)

    search_date = _get_last_updated(ctx.db, 'lore', ctx.config.initial_search_age)
    assert search_date is not None

    if ctx.config.search_title:
        search_title = f's:{ctx.config.search_title}'
    else:
        search_title = ''

    url = f'{ctx.config.list_url}?q=({from_str})+{search_title}+rt:{search_date}..'
    while url is not None:
        r = requests_session().get(url)
        p = LoreSearchParser(found_change_id)
        p.feed(r.text)
        url = p.next_url
        if url is not None and url.startswith('?'):
            url = f'{ctx.config.list_url}{url}'

    # set to yesterday to account for timezones
    yesterday = (datetime.now() - timedelta(10)).strftime('%Y-%m-%d')
    _set_last_updated(ctx.db, 'lore', yesterday)

    ctx.db.commit()

