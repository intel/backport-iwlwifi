def _table_name(name):
    if name[0].isalnum() and not name[0].isalpha():
        name = '_' + name
    return ''.join(c if c.isalnum() else '_' for c in name)

def _find_message_ids(lines):
    for line in lines:
        for pfx in (b'Link: https://lore.kernel.org/',
                    b'Link: https://msgid.link/',
                    b'Link: https://patch.msgid.link/'):
            if line.startswith(pfx):
                msgid = line[len(pfx):]
                if msgid.startswith(b'r/'):
                    msgid = msgid[2:]
                if msgid.endswith(b'/'):
                    msgid = msgid[:-1]
                yield msgid.decode('ascii', errors='ignore')

def _find_change_id(lines):
    change_id = None
    change_id_link = None
    for line in lines:
        if line.startswith(b'Change-Id: I'):
            change_id = line[len(b'Change-Id: '):].decode('ascii')
    for msgid in _find_message_ids(lines):
        if msgid.endswith('@changeid'):
            possible = msgid.split('.')[-1]
            change_id_link = possible.split('@')[0]
            if not change_id_link.startswith('I') or len(change_id_link) != 41:
                change_id_link = None

    # prefer real one over Link tag
    if change_id is not None:
        return change_id
    if change_id_link is not None:
        return change_id_link
    return None

# handles both Change-Id: and List: format
# will commit the transaction and last-update itself
def _map_change_ids(db, table, git_dir, branch):
    db.execute(f'CREATE TABLE IF NOT EXISTS {table} (sha1 UNIQUE, change_id UNIQUE)')

    last_checked_key = f'change-ids-{table}'
    last_checked = _get_last_updated(db, last_checked_key)
    if last_checked is None:
        rev_list = branch
    else:
        rev_list = f'{last_checked}..{branch}'
    cur = db.cursor()
    first_sha1 = None
    with subprocess.Popen(['git', '-C', git_dir, 'log', '-z', '--format=%H%n%B', rev_list, '--'],
                          stdout=subprocess.PIPE) as p:
        for record in _zero_iter(p.stdout):
            lines = record.splitlines()
            sha1 = lines[0].decode('ascii')
            if first_sha1 is None:
                first_sha1 = sha1
            change_id = _find_change_id(lines)
            if change_id:
                cur.execute(f'INSERT OR REPLACE INTO {table} (sha1, change_id) VALUES (?, ?)', (sha1, change_id))
        p.wait()
        assert p.returncode == 0, 'git failed'
    if first_sha1 is not None:
        _set_last_updated(db, last_checked_key, first_sha1)
    db.commit()

def _rev_parse(git_dir, ref):
    with subprocess.Popen(['git', '-C', git_dir, 'rev-parse', ref],
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as p:
        ret = p.stdout.read().strip().decode('ascii')
        p.wait()
        assert p.returncode == 0, 'git failed'
    return ret

def _map_patch_ids(ctx, table, git_dir, branch, stack_dev):
    db = ctx.db
    db.execute(f'CREATE TABLE IF NOT EXISTS {table} (sha1 UNIQUE, patch_id)')
    db.execute(f'CREATE INDEX IF NOT EXISTS index_patch_id_{table} ON {table} (patch_id)')
    cur = db.cursor()

    branch_sha1 = _rev_parse(git_dir, branch)

    last_checked_key = f'patch-ids-{table}'
    last_checked = _get_last_updated(db, last_checked_key)
    if last_checked is None:
        earliest_commit = None
        args = ['git', '-C', git_dir, 'log', '--reverse', '-z', '--format=%H']
        if branch is not None:
            args.append(branch)
        args.append('--')
        with subprocess.Popen(args, stdout=subprocess.PIPE) as p:
            for record in _zero_iter(p.stdout):
                sha1 = record.decode('ascii')
                earliest_commit = sha1
                break
            p.kill()
        assert earliest_commit
        rev_list = f'{earliest_commit}..{branch_sha1}'
    else:
        rev_list = f'{last_checked}..{branch_sha1}'
        if last_checked == branch_sha1:
            return

    logargs = ['git', '-C', git_dir, 'log', '-u']
    if not stack_dev:
        logargs.append('--full-diff')
    logargs.extend([rev_list, '--'])
    if stack_dev:
        logargs.extend(['drivers', 'net', 'include'])
    else:
        logargs.extend(ctx.config.interesting_paths)
    last_sha1 = None
    with subprocess.Popen(logargs, stdout=subprocess.PIPE) as log:
        if stack_dev:
            filterargs = ['sed', 's/CPTCFG_/CONFIG_/g']
        else:
            filterargs = ['cat', '-']
        with subprocess.Popen(filterargs, stdin=log.stdout,
                              stdout=subprocess.PIPE) as pfilter:
            with subprocess.Popen(['git', 'patch-id', '--stable'],
                                  stdin=pfilter.stdout, stdout=subprocess.PIPE) as p:
                for line in p.stdout:
                    patch_id, sha1 = line.strip().decode('ascii').split()
                    cur.execute(f'INSERT OR IGNORE INTO {table} (sha1, patch_id) VALUES (?, ?)',
                                (sha1, patch_id))
                    last_sha1 = sha1
                p.wait()
                assert p.returncode == 0, 'git failed'
            pfilter.wait()
            assert pfilter.returncode == 0, 'filter failed'
        log.wait()
        assert log.returncode == 0, 'git failed'
    _set_last_updated(db, last_checked_key, branch_sha1)
    db.commit()

def _refresh_upstream(ctx):
    _check_config(ctx.config, 'upstream_tree', 'upstream_branches')

    for name, branch in ctx.config.upstream_branches.items():
        _map_change_ids(ctx.db, f'upstream_{_table_name(name)}',
                        ctx.config.upstream_tree, branch)
        _map_patch_ids(ctx, f'upstream_patch_ids_{_table_name(name)}',
                       ctx.config.upstream_tree, branch, False)

