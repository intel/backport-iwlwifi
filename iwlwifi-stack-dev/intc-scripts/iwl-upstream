@iwl.command()
@click.pass_obj
@click.option('--local', 'local', flag_value=True, default=False)
@click.argument('input-file', type=click.Path())
def read_xlsx(ctx, local, input_file):
    '''
    Read back an XLSX file created earlier and updates state notes.
    '''
    if openpyxl is None:
        raise click.UsageError("XSLX output requires openpyxl")

    if not local:
        _refresh_notes(ctx)

    wb = openpyxl.load_workbook(filename=input_file)
    rev_list_s = wb.custom_doc_props['rev_list'].value
    rev_list_l = rev_list_s.split('\n')
    if not rev_list_l[-1]:
        rev_list_l = rev_list_l[:-1]
    assert len(rev_list_l) in (1, 2)
    if len(rev_list_l) == 2:
        assert rev_list_l[1][0] == '^'
        rev_list = f'{rev_list_l[1][1:]}..{rev_list_l[0]}'
    else:
        rev_list = rev_list_l[0]

    click.echo('re-checking states ...')
    states = _get_states(ctx, '', rev_list, [])
    existing = {}
    for commit, data in states.items():
        existing[commit[:ctx.config.abbrev]] = data
    click.echo('reading spreadsheet ...')
    ws = wb.active
    assert ws.title == 'upstreaming'
    state_col = None
    commit_col = None
    comment_col = None
    # find state, commit and comment columns
    for row in ws.iter_rows(max_row=1, values_only=True):
        for col_idx, col_name in enumerate(row):
            if col_name == 'state':
                state_col = col_idx
            elif col_name == 'commit':
                commit_col = col_idx
            elif col_name == 'comment':
                comment_col = col_idx
    assert state_col is not None
    assert commit_col is not None
    assert comment_col is not None
    for row in wb.active.iter_rows(min_row=2, values_only=True):
        state = row[state_col]
        commit = row[commit_col]
        comment = row[comment_col]
        try:
            data = existing[commit]
        except KeyError:
            click.echo(f'WARNING: commit {commit} not found - skipping!')
            continue
        if state == _abbrev_state(ctx.config.abbrev, data.state) and comment == data.comment:
            continue
        click.echo(f'commit {commit} changed:')
        if state != _abbrev_state(ctx.config.abbrev, data.state):
            click.echo(f'  state: {_abbrev_state(ctx.config.abbrev, data.state)} -> {state}')
        if comment != data.comment:
            click.echo('  comment: %r -> %r' % (data.comment, comment))

        params = {}
        if state is None:
            pass
        elif state in ('noupstream', 'upstream', 'squashed', 'reverted', 'revert'):
            pass
        elif state.startswith('upstream:') or state.startswith('squashed:') or \
             state.startswith('reverted:') or state.startswith('revert:'):
            state, commit_id = state.split(':', 1)
            if state == 'upstream':
                git_dir = ctx.config.upstream_tree
            else:
                git_dir = '.'
            try:
                params['commit-id'] = _rev_parse(git_dir, commit_id)
            except:
                click.echo(f'  WARNING: {state} commit ID {commit_id} unknown - skipping!')
                continue
        else:
            click.echo(f'  WARNING: new state {state} is invalid - skipping!')
            continue

        # this is a bit of a hack ...
        ctx.commit = commit
        ctx.comment = comment or '' # openpyxl does None for empty cells
        # we'll just push in the end all together if needed
        ctx.local = True
        _set_note(ctx, state or '', params)

    if not local:
        subprocess.run(['git', 'push', ctx.config.notes_remote,
                        f'{notes_ref}:{notes_ref}'], check=True)

if __name__ == '__main__':
    p = subprocess.run(['git', '-C',
                        os.path.dirname(os.path.realpath(__file__)),
                        'rev-parse', '--show-toplevel'],
                       stdout=subprocess.PIPE, check=True)
    os.chdir(p.stdout.strip())
    iwl()
