def _query_patchwork(ctx, msgid):
    ctx.db.execute('CREATE TABLE IF NOT EXISTS patchwork (message_id UNIQUE, state)')
    cur = ctx.db.cursor()

    res = cur.execute('SELECT state FROM patchwork WHERE message_id=?', (msgid, ))
    res = res.fetchone()
    if res:
        return res[0]
    return None

def _is_noupstream_patch(ctx, subj, files):
    if ctx.config.noupstream_subj and ctx.config.noupstream_subj in subj:
        return True
    for f in files:
        ignored = False
        for pfx in ctx.config.noupstream_files:
            if f.startswith(pfx):
                ignored = True
        if not ignored:
            return False
    return True

def _determine_state(ctx, change_id_map, result, sha1, change_id, fixes,
                     subj, files, note):
    cur = ctx.db.cursor()

    if note and 'state' in note:
        if note['state'] in ('upstream', 'squashed', 'reverted', 'revert', 'reverted-upstream'):
            if 'commit-id' in note:
                return f'{note["state"]}:{note["commit-id"]}'
            return note["state"]
        if note['state'] == 'noupstream':
            return 'noupstream'
        assert False, f'Found unknown state "{note["state"]}" in note!'

    # first check if it was applied somewhere
    for name, branch in ctx.config.upstream_branches.items():
        table = _table_name(name)
        res = cur.execute(f'SELECT sha1 FROM upstream_{table} WHERE change_id=?',
                          (change_id, )).fetchone()
        if res is not None:
            return f'applied:{name}:{res[0]}'

    # check if found by patch-id upstream
    res = cur.execute(f'SELECT patch_id FROM local_patch_ids WHERE sha1=?', (sha1, )).fetchone()
    if res is not None:
        patch_id = res[0]
        for name, branch in ctx.config.upstream_branches.items():
            table = _table_name(name)
            res = cur.execute(f'SELECT sha1 FROM upstream_patch_ids_{table} WHERE patch_id=?',
                              (patch_id, )).fetchone()
            if res is not None:
                return f'applied:{name}:{res[0]}'

    # next check for sent to list, both lore by change-id and upstream message-id
    # (maybe this should check for all potential message IDs, not just the last?)
    res = cur.execute('SELECT message_id, rfc FROM lore WHERE change_id=? ORDER BY message_id DESC LIMIT 1',
                      (change_id, )).fetchone()
    if res is not None:
        msgid, is_rfc = res

        pw = _query_patchwork(ctx, msgid)
        if pw is not None:
            return f'patchwork:{pw}'
        return 'sent-rfc' if is_rfc else 'sent'

    res = cur.execute('SELECT message_id FROM upstream_message_ids WHERE sha1=?', (sha1, )).fetchone()
    if res is not None:
        msgid = res[0]
        pw = _query_patchwork(ctx, msgid)
        if pw is not None:
            return f'patchwork:{pw}'
        return 'from-upstream'

    if _is_noupstream_patch(ctx, subj, files):
        return 'noupstream'

    # last check if it can/should be squashed
    squash_into = []
    for f in fixes or []:
        fix_sha1 = change_id_map.get(f)
        if not fix_sha1:
            continue
        data = result.get(fix_sha1)
        if not data:
            continue
        if not _accepted_state(data.state):
            squash_into.append(fix_sha1)
    if squash_into:
        return 'squash-into:' + ','.join(squash_into)

    return None

def _get_states(ctx, extra, rev_list, paths):
    # refresh the local change-id table
    _map_change_ids(ctx.db, 'local', '.', 'HEAD')
    # and patch-ids
    _map_patch_ids(ctx, 'local_patch_ids', '.', 'HEAD', True)
    # and from-upstream links
    _map_links(ctx)

    # load it to a dict
    cur = ctx.db.cursor()
    cur.execute("SELECT change_id, sha1 FROM local")
    change_id_map = {}
    for change_id, sha1 in cur.fetchall():
        change_id_map[change_id] = sha1

    format = f'--format=%x00%H%n%s%n{extra}%n%B%x00notes:%N'
    logargs = ['git', 'log', '--name-only', '--first-parent', '--no-merges', '-z', '--reverse', format,
               f'--notes={ctx.config.notes_branch}']
    if rev_list:
        logargs.append(rev_list)
    if paths:
        logargs.append('--')
        logargs.extend(paths)
    result = OrderedDict()
    with subprocess.Popen(logargs, stdout=subprocess.PIPE) as p:
        for record in _zero_iter(p.stdout, sep=b'\x00\x00'):
            # first record ...
            if record[0] == 0:
                record = record[1:]
            record, note, *files = record.split(b'\x00')
            note = note.decode('utf-8')
            assert note.startswith('notes:')
            note = yaml.safe_load(note[6:])
            if files:
                if files[0].startswith(b'\n'):
                    files[0] = files[0][1:]
                files = [f for f in files if f]
            lines = record.splitlines()
            sha1 = lines[0].decode('ascii')
            subj = lines[1].decode('utf-8')
            display = lines[2].decode('utf-8')
            fixes = _find_fixes(lines)
            data = PatchData()
            data.state = _determine_state(ctx, change_id_map, result, sha1,
                                          _find_change_id(lines), fixes,
                                          subj, [f.decode('utf-8') for f in files],
                                          note)
            if data.state and data.state.startswith('squash-into:'):
                squash_sha1s = data.state[len('squash-into:'):].split(',')
                for squash_into in squash_sha1s:
                    result[squash_into].squashes.append(sha1)
            data.display = display
            data.comment = note.get('comment') if note else None
            # OrderedDict, so this goes to the end
            result[sha1] = data
    return result

def _is_still_todo(state):
    if not state:
        return True
    if _accepted_state(state):
        return False
    if state.startswith('squash-into:'):
        return True
    if state.startswith('patchwork:'):
        # patchwork accepted states handled in _accepted_state()
        return True
    if state in ('sent', 'sent-rfc', 'from-upstream'):
        return True
    if state in ('noupstream', 'squashed', 'reverted', 'revert'):
        return False
    for tp in ('reverted', 'squashed', 'revert'):
        if state.startswith(f'{tp}:'):
            return False
    if state.startswith('squash-with:'):
        return True
    if state.startswith('reverted-upstream'):
        return True
    assert False, f"bad state '{state}'"

def _abbrev_state(abbrev, state):
    if not state:
        return state
    if state.startswith('applied:'):
        state, tree, sha1 = state.split(':')
        return f'applied:{tree}:{sha1[:abbrev]}'
    for tp in ('upstream', 'reverted', 'reverted-upstream', 'revert'):
        if state.startswith(f'{tp}:'):
            sha1 = state.split(':')[1]
            return f'{tp}:{sha1[:abbrev]}'
    if state.startswith('squash-into:') or state.startswith('squashed:'):
        tp, sha1s = state.split(':')
        sha1list = [s[:abbrev] for s in sha1s.split(',')]
        return f'{tp}:{",".join(sha1list)}'
    return state

def _color(state):
    if not state:
        return None
    if state in ('sent', 'sent-rfc', 'from-upstream',
                 'patchwork:new', 'patchwork:under-review'):
        return 'yellow'
    if state in ('noupstream'):
        return 'green'
    if _accepted_state(state) or state.startswith('squashed'):
        return 'green'
    if state.startswith('reverted:') or state == 'reverted':
        return 'green'
    if state.startswith('revert:') or state == 'revert':
        return 'green'
    if state in ('patchwork:rejected', ):
        return 'red'
    return None

def _xlsx_color(state):
    map = {
        None: None,
        'red': 'FF0000',
        'green': '00FF00',
        'yellow': 'FFFF00',
    }
    return map[_color(state)]

def _color_state(state, print_state):
    color = _color(state)
    if color is None:
        return print_state
    return click.style(print_state, fg=color)

def _log_to_state(ctx, rev_list, paths, filters, mode, outfile, color):
    if mode in ('csv', 'xlsx'):
        extra = '%h,' + ctx.config.csv_format
    else:
        extra = ctx.config.display_format
    result = _get_states(ctx, extra, rev_list, paths)
    if mode in ('csv', 'xlsx'):
        hdr = ['state', 'commit']
        split_header = ctx.config.csv_format_header.split(',')
        # we added the commit ID always, so no -1
        num_header_items = len(split_header)
        hdr.extend(split_header)
        hdr.append('comment')
        if mode == 'csv':
            csv_writer = csv.writer(outfile)
            csv_writer.writerow(hdr)
        else:
            outfile.append(hdr)
            row = outfile.row_dimensions[1]
            row.font = openpyxl.styles.Font(bold=True)
    for sha1, data in reversed(result.items()):
        if filters.no_applied and _accepted_state(data.state):
            continue
        if filters.no_sent and data.state == 'sent':
            continue
        if filters.todo and not _is_still_todo(data.state):
            continue
        if data.state == 'noupstream' and not filters.noupstream:
            continue
        print_state = _abbrev_state(ctx.config.abbrev, data.state) or ''
        if _is_still_todo(data.state) and data.squashes:
            squashes = [s[:ctx.config.abbrev] for s in data.squashes]
            sep = "/" if print_state else ""
            print_state = f'{print_state}{sep}squash-with:{",".join(squashes)}'
        if mode in ('csv', 'xlsx'):
            row = [print_state]
            row.extend(data.display.split(',', num_header_items))
            row.append(data.comment)
            if mode == 'csv':
                csv_writer.writerow(row)
            else:
                outfile.append(row)
                rownum = outfile.max_row
                color = _xlsx_color(data.state)
                if color:
                    fill = openpyxl.styles.PatternFill(start_color=color,
                                                       fill_type='solid')
                    outfile[f'A{rownum}'].fill = fill
        else:
            print_state = _pad(print_state, ctx.config.width)
            print_state = _color_state(data.state, print_state)
            click.echo(print_state + ' ' + data.display, color=color, file=outfile)
            if data.comment:
                click.echo(f'comment: {data.comment}', file=outfile)

@iwl.command()
@click.option('--no-sent', 'no_sent', flag_value=True, default=False)
@click.option('--no-applied', 'no_applied', flag_value=True, default=False)
@click.option('--noupstream', 'noupstream', flag_value=True, default=False)
@click.option('--todo', 'todo', flag_value=True, default=False)
@click.option('--mode',
              type=click.Choice(['text', 'csv', 'xlsx'], case_sensitive=False),
              default='text')
@click.option('--outfile', type=click.Path(), default='-')
@click.option('--color/--no-color', 'color', flag_value=True, default=None)
@click.argument('rev-list', required=False)
@click.argument('paths', nargs=-1)
@click.pass_obj
def state(ctx, no_sent, no_applied, noupstream, todo, mode, outfile, color, rev_list, paths):
    '''
    Display the state of patches.
    '''
    assert not '%n' in ctx.config.display_format, "Display format cannot have %n"
    filters = Filters()
    filters.no_sent = no_sent
    filters.no_applied = no_applied
    filters.noupstream = noupstream
    filters.todo = todo

    if mode == 'xlsx':
        if openpyxl is None:
            raise click.UsageError("XSLX output requires openpyxl")
        filemode = 'wb'
    else:
        filemode = 'w'

    if outfile == '-':
        if mode == 'xlsx':
            raise click.UsageError("Must write XLSX to file")
        outfile_f = sys.stdout
    elif mode == 'xlsx':
        workbook = openpyxl.Workbook()
        outfile_f = workbook.active
        outfile_f.title = 'upstreaming'
    else:
        outfile_f = open(outfile, filemode)

    if rev_list is None and ctx.config.cutoff:
        rev_list = f'{ctx.config.cutoff}..'

    _log_to_state(ctx, rev_list, paths, filters, mode, outfile_f, color)

    if mode == 'xlsx':
        # capture the rev_list to reproduce the state on input later
        SP = openpyxl.packaging.custom.StringProperty
        if rev_list is None:
            rev_list = 'HEAD'
        p = subprocess.run(['git', 'rev-parse', rev_list], stdout=subprocess.PIPE,
                           check=True)
        workbook.custom_doc_props.append(SP(name="rev_list",
                                            value=p.stdout.decode('ascii')))
        workbook.save(outfile)

def _parse_ref_arg(git_dir, ref, msg):
    try:
        return _rev_parse(git_dir, ref)
    except:
        raise click.BadParameter(msg)

def _set_note(ctx, state, update=None):
    update = (update or {}).copy()
    update['state'] = state
    if ctx.comment is not None:
        update['comment'] = ctx.comment
    assert ctx.commit is not None
    notes_ref = f'refs/notes/{ctx.config.notes_branch}'
    if not ctx.local:
        _refresh_notes(ctx)

    p = subprocess.run(['git', 'notes', f'--ref={ctx.config.notes_branch}',
                       'show', ctx.commit], check=False,
                       capture_output=True)
    if p.returncode == 0:
        have_note = True
        info = yaml.safe_load(p.stdout.decode('utf-8'))
    else:
        have_note = False
        info = {}

    for k, v in update.items():
        if v is None:
            continue
        if not v:
            if k in info:
                del info[k]
        else:
            info[k] = v

    if not info:
        args = ['git', 'notes', f'--ref={ctx.config.notes_branch}', 'remove',
                ctx.commit]
        input = None
        run = have_note
    else:
        input = yaml.dump(info).encode('utf-8')
        args = ['git', 'notes', f'--ref={ctx.config.notes_branch}', 'add',
                '-F-', '-f', ctx.commit]
        run = True

    try:
        if run:
            subprocess.run(args, check=True, input=input)
    except:
        raise click.Abort()

    if not ctx.local:
        subprocess.run(['git', 'push', ctx.config.notes_remote,
                        f'{notes_ref}:{notes_ref}'], check=True)

@iwl.group()
@click.pass_obj
@click.option('--comment', 'comment')
@click.option('--local', 'local', flag_value=True, default=False)
@click.argument('commit')
def set(ctx, comment, local, commit):
    '''
    Set the state of the given COMMIT.
    '''
    ctx.comment = comment
    ctx.local = local
    ctx.commit = _parse_ref_arg('.', commit, f"commit '{commit}' not known")

@set.command()
@click.pass_obj
@click.argument('ref', required=False)
def upstream(ctx, ref):
    '''
    Set the commit to upstreamed as REF.

    REF can be a sha1 or any other reference to a patch that can be
    resolved in the upstream tree.
    '''
    if ref is not None:
        ref = _parse_ref_arg(ctx.config.upstream_tree, ref,
                             f"ref/sha1 '{ref}' not known in upstream tree")
    info = {}
    if ref is not None:
        info['commit-id'] = ref
    _set_note(ctx, 'upstream', info)

@set.command()
@click.pass_obj
def noupstream(ctx):
    '''
    Set the commit to not be upstreamed.
    '''
    _set_note(ctx, 'noupstream')

@set.command()
@click.pass_obj
@click.argument('into', required=False)
def squashed(ctx, into):
    '''
    Set the commit to squashed (optionally into INTO).

    INTO refers to a commit in the local tree (not upstream),
    and can be given as a Change-Id or sha1/git ref.
    '''
    # refresh the local change-id table
    _map_change_ids(ctx.db, 'local', '.', 'HEAD')

    cur = ctx.db.cursor()

    params = {}
    if into is not None:
        if len(into) == 41 and into[0] == 'I':
            cur.execute("SELECT sha1 FROM local WHERE change_id=?", (into, ))
            res = cur.fetchone()
            if res is None:
                raise click.BadParameter(f'{into} is not a Change-Id that exists!')
            sha1 = res[0]
        else:
            sha1 = _parse_ref_arg('.', into, f"ref/sha1 '{into} not known")

        if sha1 == ctx.commit:
            raise click.BadParameter(f'cannot mark patch as squashed into itself!')

        params['commit-id'] = sha1

    _set_note(ctx, 'squashed', params)

@set.command()
@click.pass_obj
@click.argument('by', required=False)
def reverted(ctx, by):
    '''
    Set the commit to reverted (optionally by BY).

    BY refers to a commit in the local tree (not upstream),
    and can be given as a Change-Id or sha1/git ref.
    '''
    # refresh the local change-id table
    _map_change_ids(ctx.db, 'local', '.', 'HEAD')

    cur = ctx.db.cursor()

    params = {}
    if by is not None:
        if len(by) == 41 and by[0] == 'I':
            cur.execute("SELECT sha1 FROM local WHERE change_id=?", (by, ))
            res = cur.fetchone()
            if res is None:
                raise click.BadParameter(f'{by} is not a Change-Id that exists!')
            sha1 = res[0]
        else:
            sha1 = _parse_ref_arg('.', by, f"ref/sha1 '{by} not known")

        if sha1 == ctx.commit:
            raise click.BadParameter(f'cannot mark patch as reverted by itself!')

        # mark the revert as well
        real_commit = ctx.commit
        ctx.commit = sha1
        revert_params = {
            'commit-id': real_commit,
        }
        _set_note(ctx, 'revert', revert_params)
        ctx.commit = real_commit

        params['commit-id'] = sha1

    _set_note(ctx, 'reverted', params)

@set.command()
@click.pass_obj
@click.argument('of')
def revert(ctx, of):
    '''
    Set the commit to be a revert of OF.

    OF refers to a commit in the local tree (not upstream),
    and can be given as a Change-Id or sha1/git ref.
    '''
    # refresh the local change-id table
    _map_change_ids(ctx.db, 'local', '.', 'HEAD')

    cur = ctx.db.cursor()

    if len(of) == 41 and of[0] == 'I':
        cur.execute("SELECT sha1 FROM local WHERE change_id=?", (of, ))
        res = cur.fetchone()
        if res is None:
            raise click.BadParameter(f'{of} is not a Change-Id that exists!')
        sha1 = res[0]
    else:
        sha1 = _parse_ref_arg('.', of, f"ref/sha1 '{of} not known")

    if sha1 == ctx.commit:
        raise click.BadParameter(f'cannot mark patch as reverting itself!')

    # mark the reverted as well
    real_commit = ctx.commit
    ctx.commit = sha1
    reverted_params = {
        'commit-id': real_commit,
    }
    _set_note(ctx, 'reverted', reverted_params)
    ctx.commit = real_commit

    params = {
        'commit-id': sha1,
