def _refresh_patchwork(ctx):
    ctx.db.execute('CREATE TABLE IF NOT EXISTS patchwork (message_id UNIQUE, state)')
    cur = ctx.db.cursor()

    patchwork = ctx.config.patchwork_url
    if not patchwork.endswith('/'):
        patchwork += '/'

    url = f'{patchwork}events/?project={ctx.config.patchwork_project}&order=date'
    pp = '&per_page=100'

    last_date = _get_last_updated(ctx.db, 'patchwork')
    if last_date is None:
        r = requests_session().get(url + '&per_page=1')
        if r.status_code != 200:
            raise click.ClickException(f'Error {r.status_code} loading {url}&per_page=1=')
        last_date = r.json()[0]['date']
    since_str = f'&since={last_date}' # inclusive, so this is always OK

    prior_id = None
    with DateProgressBar(parser.parse(last_date)) as pgbar:
        while True:
            r = requests_session().get(url + since_str + pp)
            if r.status_code != 200:
                raise click.ClickException(f'Error {r.status_code} loading {url}{since_str}{pp}')

            last_date = None
            last_id = None

            for event in r.json():
                last_date = event['date']
                last_id = event['id']

                category = event['category']
                try:
                    msgid = event['payload']['patch']['msgid']
                    if msgid[0] == '<':
                        msgid = msgid[1:]
                    if msgid[-1] == '>':
                        msgid = msgid[:-1]
                except KeyError:
                    continue
                if category == 'patch-created':
                    cur.execute('INSERT OR REPLACE INTO patchwork (message_id, state) VALUES (?, ?)',
                                (msgid, 'new'))
                elif category == 'patch-state-changed':
                    cur.execute('INSERT OR REPLACE INTO patchwork (message_id, state) VALUES (?, ?)',
                                (msgid, event['payload']['current_state']))
            if last_date is None or last_id is None:
                break
            _set_last_updated(ctx.db, 'patchwork', last_date)
            ctx.db.commit()
            if prior_id == last_id:
                pgbar.finish()
                break
            prior_id = last_id
            since_str = f'&since={last_date}'
            pgbar.set_pos(parser.parse(last_date))


