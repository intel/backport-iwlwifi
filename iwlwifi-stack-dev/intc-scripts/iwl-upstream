def _map_links(ctx):
    ctx.db.execute(f'CREATE TABLE IF NOT EXISTS upstream_message_ids (sha1 UNIQUE, message_id)')
    cur = ctx.db.cursor()

    head = _rev_parse('.', 'HEAD')
    message_id_mapped_last = _get_last_updated(ctx.db, 'upstream_message_ids',
                                               ctx.config.cutoff)
    if message_id_mapped_last:
        rev_list = f'{message_id_mapped_last}..{head}'
    else:
        rev_list = f'{head}'

    first_sha1 = None
    with subprocess.Popen(['git', 'log', '-z', '--first-parent', '--no-merges',
                           '--format=%H%n%B', '--grep=Link: https://', rev_list,
                           '--'],
                          stdout=subprocess.PIPE) as p:
        for record in _zero_iter(p.stdout):
            lines = record.splitlines()
            sha1 = lines[0].decode('ascii')
            if first_sha1 is None:
                first_sha1 = sha1
            for message_id in _find_message_ids(lines):
                cur.execute(f'INSERT OR IGNORE INTO upstream_message_ids (sha1, message_id) VALUES (?, ?)',
                            (sha1, message_id))
        p.wait()
        assert p.returncode == 0, 'git failed'
    _set_last_updated(ctx.db, 'upstream_message_ids', head)
    ctx.db.commit()


def _find_fixes(lines):
    fixes = []
    for line in lines:
        if line.startswith(b'fixes=I'):
            tentative = line[6:]
            if len(tentative) == 41:
                fixes.append(tentative.decode('ascii'))
    return fixes or None

